# Copy to .env.local (git-ignored) for local development.
# Where the backend lives. In dev, Vite proxies /api to PROXY_TARGET.
DP_API_BASE_URL=/api
PROXY_TARGET=http://localhost:8080

# Run against the built-in mock API instead of a real backend (only honoured by `npm run local`).
DP_USE_MOCK=false

# Client-side upload limit in MB (the backend must enforce its own).
DP_MAX_FILE_SIZE_MB=50
